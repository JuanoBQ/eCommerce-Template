# ===========================================
# CONFIGURACIÓN PARA PRODUCCIÓN EN HOSTINGER
# ===========================================

# Ambiente
DJANGO_ENVIRONMENT=production
DEBUG=False

# Dominio
ALLOWED_HOSTS=tu-dominio.com,www.tu-dominio.com

# URLs
FRONTEND_URL=https://tu-dominio.com
BACKEND_URL=https://tu-dominio.com/api

# Seguridad
SECRET_KEY=tu-clave-secreta-super-segura-aqui
USE_SSL=True

# Base de datos MySQL (Hostinger)
DB_NAME=tu_nombre_base_datos
DB_USER=tu_usuario_db
DB_PASSWORD=tu_password_db
DB_HOST=localhost
DB_PORT=3306

# Archivos estáticos y media
STATIC_ROOT=/home/tu-usuario/public_html/static/
MEDIA_ROOT=/home/tu-usuario/public_html/media/
STATIC_URL=/static/
MEDIA_URL=/media/

# Cache
CACHE_LOCATION=/tmp/django_cache

# Logs
LOG_FILE=/home/tu-usuario/logs/django.log
ERROR_LOG_FILE=/home/tu-usuario/logs/django_errors.log

# Email (Hostinger SMTP)
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@tu-dominio.com
EMAIL_HOST_PASSWORD=tu-password-email
DEFAULT_FROM_EMAIL=noreply@tu-dominio.com

# CORS
CORS_ALLOWED_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

# Wompi (Producción)
WOMPI_PUBLIC_KEY=pub_prod_xxxxx
WOMPI_PRIVATE_KEY=prv_prod_xxxxx  
WOMPI_WEBHOOK_SECRET=eventos_prod_xxxxx
WOMPI_ENVIRONMENT=production
WOMPI_INTEGRITY_KEY=prod_integrity_xxxxx

# MercadoPago (Producción)
MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxx-prod
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxx-prod
MERCADOPAGO_WEBHOOK_SECRET=tu-webhook-secret-prod
MERCADOPAGO_ENVIRONMENT=production

# JWT
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=tu-jwt-secret-key

# Celery (Simplificado para Hostinger)
CELERY_BROKER_URL=django://
CELERY_RESULT_BACKEND=django-db
CELERY_TASK_ALWAYS_EAGER=True

# Base de datos pool (opcional)
DB_POOL=False
