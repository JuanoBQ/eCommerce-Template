# ===========================================
# CONFIGURACIÓN DE PRODUCCIÓN
# ===========================================

# Django Settings
SECRET_KEY=your-super-secret-key-here-change-in-production
DEBUG=False
DJANGO_ENVIRONMENT=production
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,api.yourdomain.com

# Database Configuration
DB_NAME=ecommerce_prod
DB_USER=ecommerce_user
DB_PASSWORD=your-secure-database-password
DB_HOST=your-database-host
DB_PORT=5432

# Redis Configuration
REDIS_URL=redis://your-redis-host:6379/0

# Frontend/Backend URLs
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://api.yourdomain.com

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOW_CREDENTIALS=True

# ===========================================
# PAYMENT GATEWAYS
# ===========================================

# Wompi Configuration
WOMPI_PUBLIC_KEY=your-wompi-public-key
WOMPI_PRIVATE_KEY=your-wompi-private-key
WOMPI_WEBHOOK_SECRET=your-wompi-webhook-secret
WOMPI_ENVIRONMENT=production
WOMPI_INTEGRITY_KEY=your-wompi-integrity-key

# MercadoPago Configuration
MERCADOPAGO_PUBLIC_KEY=your-mercadopago-public-key
MERCADOPAGO_ACCESS_TOKEN=your-mercadopago-access-token
MERCADOPAGO_WEBHOOK_SECRET=your-mercadopago-webhook-secret
MERCADOPAGO_ENVIRONMENT=production

# ===========================================
# MONITORING & LOGGING
# ===========================================

# Sentry Configuration
SENTRY_DSN=your-sentry-dsn-here
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=1.0.0

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=/var/log/ecommerce/django.log

# ===========================================
# EMAIL CONFIGURATION
# ===========================================

# SMTP Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.your-email-provider.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@yourdomain.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ===========================================
# SECURITY
# ===========================================

# Security Settings
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY

# Session Security
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_AGE=86400
CSRF_COOKIE_SECURE=True
CSRF_COOKIE_HTTPONLY=True

# ===========================================
# CACHE CONFIGURATION
# ===========================================

# Cache Settings
CACHE_DEFAULT_TIMEOUT=300
CACHE_PRODUCTS_TIMEOUT=3600
CACHE_SESSIONS_TIMEOUT=86400
CACHE_PAYMENTS_TIMEOUT=1800

# ===========================================
# FILE STORAGE
# ===========================================

# AWS S3 Configuration (opcional)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=your-cdn-domain.com
AWS_DEFAULT_ACL=public-read
AWS_S3_OBJECT_PARAMETERS={
    'CacheControl': 'max-age=86400',
}

# ===========================================
# CELERY CONFIGURATION
# ===========================================

# Celery Settings
CELERY_BROKER_URL=redis://your-redis-host:6379/4
CELERY_RESULT_BACKEND=redis://your-redis-host:6379/5
CELERY_ACCEPT_CONTENT=['json']
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=America/Bogota

# ===========================================
# PERFORMANCE
# ===========================================

# Database Connection Pool
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=True

# Cache Performance
CACHE_MIDDLEWARE_SECONDS=300
CACHE_MIDDLEWARE_KEY_PREFIX=ecommerce

# ===========================================
# BACKUP CONFIGURATION
# ===========================================

# Backup Settings
BACKUP_ENABLED=True
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket

# ===========================================
# MONITORING
# ===========================================

# Health Check Settings
HEALTH_CHECK_ENABLED=True
HEALTH_CHECK_TIMEOUT=30

# Performance Monitoring
PERFORMANCE_MONITORING=True
SLOW_QUERY_THRESHOLD=1.0  # seconds