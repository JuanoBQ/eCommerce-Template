# ===========================================
# CONFIGURACIÓN PARA DESARROLLO
# ===========================================

# Ambiente
DJANGO_ENVIRONMENT=development
DEBUG=True

# Base de datos PostgreSQL
DB_NAME=ecommerce_dev
DB_USER=ecommerce_user
DB_PASSWORD=ecommerce_password
DB_HOST=db
DB_PORT=5432

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Seguridad
SECRET_KEY=django-insecure-development-key-change-in-production
USE_SSL=False


# Email (Console para desarrollo)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Wompi (Sandbox)
WOMPI_PUBLIC_KEY=pub_test_xxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxx
WOMPI_WEBHOOK_SECRET=eventos_test_xxxxx
WOMPI_ENVIRONMENT=sandbox
WOMPI_INTEGRITY_KEY=test_integrity_xxxxx

# MercadoPago (Sandbox)
MERCADOPAGO_PUBLIC_KEY=TEST-xxxxx
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxx
MERCADOPAGO_WEBHOOK_SECRET=test-webhook-secret
MERCADOPAGO_ENVIRONMENT=sandbox

# JWT
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=jwt-development-secret-key

# Sentry (Desarrollo - opcional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Logging
LOG_LEVEL=DEBUG
